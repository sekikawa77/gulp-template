include asset/inc/_variable
- var title = pages.top[0].title
- var description = pages.top[0].description
- var keywords = pages.top[0].keywords
- var pageType = 'top';

doctype html
html(lang='ja')
	head
		include asset/inc/_head
		include asset/inc/_gtag
	body
		include asset/inc/_header

		main.l-main
			section.p-main-visual
				.l-inner
					p.c-text__01 あああああああああああああああああああああああああああああ
					p.c-text__02 ううううううううううううううううううううううう
			section.l-section
				.l-inner
					p.c-text__01
						a(href="pages.works[0].children[0].url")= pages.works[0].children[0].title
			section.l-section
				.l-inner
					p.c-text__01(style="padding-block: 200px; background: red; color: white;" id="anc-02") #anc-02
			section.l-section
				.l-inner
					p.c-text__01(style="padding-block: 200px; background: pink; color: white;" id="anc-03") #anc-03
			section.l-section
				.l-inner
					p.c-text__01(style="padding-block: 200px; background: green; color: white;" id="anc-04") #anc-04
			section.l-section
				.l-inner
					p.c-text__01(style="padding-block: 200px; background: blue; color: white;" id="anc-05") #anc-05
		include asset/inc/_footer

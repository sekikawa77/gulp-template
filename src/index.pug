include asset/inc/_variable
- var title = pages.top[0].title
- var description = pages.top[0].description
- var keywords = pages.top[0].keywords
- var pageType = 'top';

doctype html
html(lang='ja')
	head
		include asset/inc/_head
		include asset/inc/_gtag
	body
		include asset/inc/_header

		main.l-main
			section.p-main-visual
				.l-inner
					p.c-text__01 あああああああああああああああああああああああああああああ
					p.c-text__02 ううううううううううううううううううううううう
			section.l-section
				.l-inner
					p.c-text__01
						a(href="pages.works[0].children[0].url")= pages.works[0].children[0].title

		include asset/inc/_footer
